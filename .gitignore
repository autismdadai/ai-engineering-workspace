.env
.env.*
*.pem
*.key

# Claude Code per-machine settings; copy .mcp.json.example to .mcp.json and fill in your paths
.claude/settings.local.json
.mcp.json

# Operating-system clutter
Thumbs.db
desktop.ini
.DS_Store

# The lab's template is a teaching file with placeholders only
!.env.example
